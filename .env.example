# MapTiler Cloud API key. Get one at https://cloud.maptiler.com/account/keys/
# Restrict this key to your domain(s) in the MapTiler Cloud dashboard.
VITE_MAPTILER_API_KEY=your_key_here

# Clerk publishable key (public). Get it at https://dashboard.clerk.com/~/api-keys
VITE_CLERK_PUBLISHABLE_KEY=

# Backend API. Real mode: keep VITE_USE_MOCK_API=false and set a real base URL.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=

# --- Secret: DO NOT put this in .env (which is committed). ---
# Local dev: create .env.local (gitignored) with CLERK_SECRET_KEY.
# Production: set it as a Cloudflare Worker Secret (`wrangler secret put CLERK_SECRET_KEY`).
# CLERK_SECRET_KEY=
# VITE_MAPTILER_API_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
