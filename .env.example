# MapTiler Cloud API key. Get one at https://cloud.maptiler.com/account/keys/
# Restrict this key to your domain(s) in the MapTiler Cloud dashboard.
VITE_MAPTILER_API_KEY=your_key_here

# Clerk API keys. Get them at https://dashboard.clerk.com/~/api-keys
# CLERK_SECRET_KEY is sensitive — never expose it in client code.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
