# MapTiler Cloud API key. Get one at https://cloud.maptiler.com/account/keys/
# Restrict this key to your domain(s) in the MapTiler Cloud dashboard.
VITE_MAPTILER_API_KEY=your_key_here

# Clerk publishable key (public). Get it at https://dashboard.clerk.com/~/api-keys
VITE_CLERK_PUBLISHABLE_KEY=

# Backend API. Real mode (VITE_USE_MOCK_API=false): species listing and
# recognition hit the real backend; createPost / listSightings stay on the mock.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=https://migoro.preview.aliyun-zeabur.cn

# --- Secret: DO NOT put this in .env (which is committed). ---
# Local dev: create .env.local (gitignored) with CLERK_SECRET_KEY.
# Production: set it as a Cloudflare Worker Secret (`wrangler secret put CLERK_SECRET_KEY`).
# CLERK_SECRET_KEY=
# VITE_MAPTILER_API_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=

# --- Photon Spectrum (问问 AI iMessage invite) — server-only secrets. ---
# Get both values from the backend team's Photon project. NO VITE_ prefix:
# they are read via process.env inside the server function only.
# Local dev: put them in .env.local (gitignored), next to CLERK_SECRET_KEY.
# Do NOT create a .dev.vars file — its presence stops the Cloudflare vite
# plugin from loading .env/.env.local into the worker's process.env.
# Production: `wrangler secret put PHOTON_PROJECT_ID` / `wrangler secret put PHOTON_PROJECT_SECRET`.
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=
